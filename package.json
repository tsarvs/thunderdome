{
  "name": "thunderdome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25 <26"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/game-dev-toolkit/*",
    "games/*",
    "tools/*"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "yarn workspaces run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "thunderdome": "tsx apps/cli/src/index.ts",
    "boundary-check": "yarn workspace @thunderdome/boundary-check run start",
    "scaffold:game": "node scripts/scaffold-game.mjs",
    "scaffold:bot": "node scripts/scaffold-bot.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.4"
  }
}
